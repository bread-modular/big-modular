(text "02 / INDEPENDENT HARDWARE GATE" (at 20.32 17.78 0) (effects (font (size 2.2 2.2)) (justify left)) (uuid "5a99d7db-af96-5cd0-a332-3f2d5706db03"))
(text "7.878 / 10.781 V nominal hardware window. RTN is NOT GND.\nR8 6.04k: 1.987 A nominal, not 3 A. MODE 402k: current limit with thermal latch-off.\nJP1 RUN default OPEN; PG hardware permission; no debug controller required. FLT is aggregate, not per-rail overload proof." (at 20.32 30.48 0) (effects (font (size 1.02 1.02)) (justify left)) (uuid "4686b98a-9d9a-5c07-958a-54409a0f472d"))
(text "Hardware PG -> Q1 -> JP1 -> SHDN, always subject to UV/OV window.\nRUN must be deliberately closed only after power-up blockers are cleared." (at 20.32 264.16 0) (effects (font (size 1.05 1.05)) (justify left)) (uuid "ddc07355-84df-5a46-9881-40c751bf327f"))
