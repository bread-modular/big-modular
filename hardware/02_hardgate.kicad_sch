	(text "SW1 PRESS: SHDN -> RTN, eFuse OFF; RELEASE: internal 2.0..3.4 V bias retries.\nNo AUX/PG/JP1 or external permission. UV/OV/current/thermal protection always applies.\nBucks use their own internal EN pullups, not this weak SHDN bias."
		(exclude_from_sim no)
		(at 20.32 264.16 0)
		(effects
			(font
				(size 1.05 1.05)
			)
			(justify left)
		)
		(uuid "8162924e-0533-5c73-bfcc-15a05aaf0988")
	)
	(text "02 / AUTONOMOUS HARDWARE WINDOW AND RETRY"
		(exclude_from_sim no)
		(at 20.32 17.78 0)
		(effects
			(font
				(size 2.2 2.2)
			)
			(justify left)
		)
		(uuid "8d836158-daed-50f8-88af-c8dfdf9d7efc")
	)
	(text "UV rising 7.878 V / OV rising 10.781 V nominal; hysteresis applies. RTN is NOT GND.\nSHDN self-biases internally; SW1 shorts SHDN to RTN while pressed, release resets/retries.\nR8 6.04k: 1.987 A nominal. MODE 402k: current limit with thermal latch-off. No PG/MCU permission."
		(exclude_from_sim no)
		(at 20.32 30.48 0)
		(effects
			(font
				(size 1.02 1.02)
			)
			(justify left)
		)
