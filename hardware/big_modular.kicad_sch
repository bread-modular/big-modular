	(text "U4 / INTERNAL +13.531/-13.921V" (exclude_from_sim no) (at 314.96 127 0) (effects (font (size 1.15 1.15)) (justify left)) (uuid "1466039e-12d4-5ed2-8f81-906e1a4ca07e"))
