	(text "MCU U3 STM32G071C8T6 at 3.3 V, HSI16, no crystal.\nVREF+ = +3V3 through FB1 (ADC/DAC reference).\nJ6 SWD: 1 +3V3 sense, 2 SWDIO, 3 SWCLK, 4 GND, 5 NRST."
		(exclude_from_sim no)
		(at 121.92 93.98 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "5040a782-9c40-5852-b37f-72f867376181")
	)
	(text "MODE: SW1 to GND on PB4 (pull-up); LED on PB5 (PWM) via R7 1k."
		(exclude_from_sim no)
		(at 228.6 271.78 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "6f22c6a2-cd38-5ea2-b54f-fe1d29fcdb18")
	)
	(text "MIDI IN (TS): 8bit NPN front end, pull-ups on +3V3. JP1 shipped OPEN:\n1-2 = protected (USART1 RXINV = 1), 2-3 = direct."
		(exclude_from_sim no)
		(at 15.24 218.44 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
