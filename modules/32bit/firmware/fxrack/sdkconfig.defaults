# 32bit module: ESP32-S3-WROOM-1U-N16R8 (16 MB flash, 8 MB octal PSRAM).
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y

# The delay / reverb buffers live in the module's PSRAM (BM allocate_psram:
# 2 s left delay = 345 KB). Octal PSRAM uses GPIO33-37 inside the module; the
# carrier leaves IO35-IO37 unconnected (docs/firmware-pins.md).
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_CAPS_ALLOC=y

# BM 32bit-5v runs at 160 MHz ("more stability").
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_160=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_FREERTOS_HZ=1000

# Logs on the USB-C port (USB-Serial/JTAG). UART0 (GPIO44) is MIDI in only.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# No radio: the 5 V linear regulator is sized for the module without Wi-Fi/BT.
# MINIMAL_BUILD links neither (main/CMakeLists.txt REQUIRES no esp_wifi / bt).
