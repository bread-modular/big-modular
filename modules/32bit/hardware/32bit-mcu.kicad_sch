	(text "I2S0 slave (codec = clock master): GPIO18 SCLK, GPIO17 LRCK, GPIO16 DIN (codec SDOUT),\nGPIO13 DOUT -> R105 -> codec SDIN, GPIO12 codec RST. I2C GPIO9 SDA / GPIO8 SCL. POT1 / POT2 GPIO7 /\nGPIO6 (ADC1), MODE GPIO38, LED GPIO39. Radio never used: LNA_IN open."
		(exclude_from_sim no)
		(at 119.38 210.82 0)
		(effects
			(font
				(size 1.1 1.1)
			)
			(justify left)
		)
		(uuid "1f4a9474-e7d0-5d41-b729-3d3213dcb3b1")
	)
	(text "USB-C (vertical, through the panel): data only (no power drawn).\nD+/D- -> USBLC6-2SC6 -> GPIO20 / GPIO19 (USB Serial/JTAG: console, Web Serial, download)."
		(exclude_from_sim no)
		(at 20.32 129.54 0)
		(effects
			(font
				(size 1.1 1.1)
			)
			(justify left)
		)
		(uuid "7c289b5a-7f8c-5c2b-b0b1-484b74bebc9b")
	)
	(text "CARRIER HEADERS: J102 = carrier J6, J103 = carrier J7 (2.54 mm pin strips,\nsoldered through both boards; the strips are in the carrier BOM). J6 pinout is 32bit-only."
		(exclude_from_sim no)
		(at 238.76 83.82 0)
		(effects
			(font
				(size 1.1 1.1)
			)
			(justify left)
		)
		(uuid "7d8cd6b5-6b30-5a06-b283-265e63ac31d1")
	)
	(text "BIG MODULAR 32BIT - MCU board, S1 (32bit S4). ESP32-S3R8 + W25Q128JVSIQ, 40 MHz, native USB on the front-panel USB-C. Circuit intent: docs/research.md section 9"
		(exclude_from_sim no)
		(at 20.32 20.32 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left)
		)
		(uuid "baa16284-044c-57d5-b193-42d46a603e66")
	)
	(text "RESET (EN) and BOOT (GPIO0) buttons are on the carrier (B side). Hold BOOT, press RESET:\nROM download mode on the USB-C. Strapping GPIO3 / GPIO45 / GPIO46 open (defaults)."
		(exclude_from_sim no)
		(at 86.36 83.82 0)
		(effects
			(font
				(size 1.1 1.1)
			)
			(justify left)
		)
		(uuid "e04acce0-e4e2-553e-bd24-ed6617ffc757")
	)
