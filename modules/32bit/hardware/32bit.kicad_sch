	(text "USB-C (data only, as Bread Modular): VBUS not connected,\nD+/D- straight to the ESP32-S3 USB PHY (flash over USB)."
		(exclude_from_sim no)
		(at 116.84 139.7 0)
		(effects
			(font
				(size 1.1 1.1)
			)
			(justify left)
		)
		(uuid "0156bc53-c534-597d-aaf3-5ef0b21b757a")
	)
	(text "MIDI IN (TS): modules/16bit NPN front end at 3.3 V, no opto -> RXD0 (GPIO44, UART0)"
		(exclude_from_sim no)
		(at 20.32 116.84 0)
		(effects
			(font
				(size 1.4 1.4)
			)
			(justify left)
		)
		(uuid "25471184-7e19-5926-a88d-68a984677da7")
	)
	(text "AUDIO IN L/R: 100k / 22k (x0.18) -> U7C/U7D follower -> 1u -> 1k -> LIN2/RIN2 (100k to VMID).\n+/-5 V -> +/-0.9 V; codec PGA sets the gain. No IN R normal: firmware handles mono."
		(exclude_from_sim no)
		(at 436.88 33.02 0)
		(effects
			(font
				(size 1.1 1.1)
			)
			(justify left)
		)
		(uuid "3fecb1c0-9d87-5ec9-86d9-97a732a17f95")
	)
	(text "POWER: +12V -> D2 -> +12V_F (op-amp V+, U8 AMS1117-5.0 -> +5V -> U9 AMS1117-3.3 -> +3V3); -12V -> D3 -> -12V_F (op-amp V-)"
		(exclude_from_sim no)
		(at 20.32 33.02 0)
		(effects
			(font
				(size 1.4 1.4)
			)
			(justify left)
		)
		(uuid "4c0d6f7c-f407-572a-b01d-74deb683954c")
	)
	(text "JP1 RX SOURCE (back, shipped OPEN, bridge one pair): 1-2 = PROTECTED (Q1 drives RXD0,\nfirmware inverts the UART RX line); 2-3 = DIRECT (unprotected, stock BM firmware). Never both."
		(exclude_from_sim no)
		(at 20.32 180.34 0)
		(effects
			(font
				(size 1.1 1.1)
			)
			(justify left)
		)
		(uuid "4ecd22ff-0ef2-5ff7-b5ba-5f3601321ad8")
	)
	(text "AUDIO OUT L/R: LOUT1/ROUT1 -> 1k -> 10u -> U5A/U5B gain 3.55 (56k/22k) -> 1k 0.5 W -> J4/J5.\n~1 Vrms codec full scale -> +/-5 V; the codec output volume trims the level."
		(exclude_from_sim no)
		(at 436.88 101.6 0)
		(effects
			(font
				(size 1.1 1.1)
			)
			(justify left)
		)
		(uuid "668767b9-feb3-5c31-9083-f7c819586c20")
	)
	(text "BIG MODULAR 32BIT - S1 schematic (Bread Modular 32bit-5v for Eurorack, 6HP, 4 layers). Circuit intent: docs/research.md; placement: docs/geometry.json"
		(exclude_from_sim no)
		(at 20.32 20.32 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left)
		)
		(uuid "76386053-7ad4-5a42-b486-525852c6e929")
	)
	(text "ESP32-S3-WROOM-1U-N16R8 (Bread Modular 32bit-5v GPIO map).\nRESET = EN low; BOOT = IO0 low at reset (download mode). IO35-37 = octal PSRAM, keep open."
		(exclude_from_sim no)
		(at 205.74 93.98 0)
		(effects
			(font
				(size 1.1 1.1)
			)
			(justify left)
		)
		(uuid "a7d72c75-96ae-5cc7-987d-1296be6df433")
	)
	(text "CV IN 1/2: tip normalled to +5V -> RV1/RV2 50k attenuator -> U7B/U7A TL074 follower\n-> 100k / 56k to +3V3 / 120k to GND, BAT54SW clamp, 1n -> U6B/U6A MCP6002 follower -> IO1/IO2.\nUnpatched: RV = 0..+5 V knob. Patched: RV scales the CV. -5.9..+6.0 V -> 0..3.3 V."
		(exclude_from_sim no)
		(at 20.32 203.2 0)
		(effects
			(font
				(size 1.1 1.1)
			)
			(justify left)
		)
		(uuid "abe145be-dd7a-5bd2-9683-077988ce1dcd")
	)
	(text "PWR_FLAG: GND/+12V/-12V mark the Eurorack entry at J6; +12V_F/-12V_F are fed only through D2/D3;\n+3V3_ESP32 (via FB1) and +3V3_8388 (via R5) are fed through passive parts."
		(exclude_from_sim no)
		(at 20.32 101.6 0)
		(effects
			(font
				(size 1.1 1.1)
			)
			(justify left)
		)
		(uuid "af43d65d-dfb6-5abd-a173-942392e2d3c3")
	)
	(text "ES8388 CODEC (Bread Modular U4): I2S IO11-14/IO21 through 33R,\nI2C IO38 (CCLK) / IO39 (CDATA), CE = GND (0x10). Inputs on LIN2/RIN2. +3V3 -> R5 10R -> +3V3_8388."
		(exclude_from_sim no)
		(at 330.2 71.12 0)
		(effects
			(font
				(size 1.1 1.1)
			)
			(justify left)
		)
		(uuid "b127c9fa-2f01-5d7a-827b-2ce08b1c320a")
	)
	(text "MODE: SW1 (6 x 6 mm THT tact) on IO8, red LED on IO18 through 1k (Bread Modular pins).\nIO18 LEDC PWM sets the LED brightness."
		(exclude_from_sim no)
		(at 322.58 248.92 0)
		(effects
			(font
				(size 1.1 1.1)
			)
			(justify left)
		)
		(uuid "fd281e91-82d3-5b55-b123-bb68371dd13b")
	)
