		(uuid "53a2642a-389b-54d0-aa24-b886c461027c")
	)
	(text "NORMALS (U4 TS5A23157): jack empty -> TN = T pulls IN low -> COM = NC (MCO_OUT / ENV_CV);\npatched -> TN open, 1M pulls IN high -> COM = NO (AIN_BUF / CVIN_DIV)."
