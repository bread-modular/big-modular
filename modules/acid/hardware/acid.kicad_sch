	)
	(text "POWER: +12V -> D1 -> +12V_F (U10, U11, U1 HT7533-1 -> +3V3); -12V -> D2 -> -12V_F (U10, U11)."
		(exclude_from_sim no)
		(at 20.32 335.28 0)
