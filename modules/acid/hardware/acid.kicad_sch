		(uuid "2905f0e7-4ff2-52df-b492-11e34137462c")
	)
	(text "SVF VACTROL DRIVER: FREQ attenuates the CV, U9A follower, R35/R36 halve it,\nU9B holds the LED cathodes at CV/2: I = (CV/2) / (CURVE + 5.1k). BM R13 pull-up omitted."
		(exclude_from_sim no)
		(at 289.56 254 0)
		(effects
