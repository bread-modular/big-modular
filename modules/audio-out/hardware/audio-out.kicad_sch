	(text "BIG MODULAR AUDIO OUT - S3 schematic (+/-12 V, pure analog). Circuit intent: docs/research.md"
		(exclude_from_sim no)
		(at 20.32 20.32 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left)
		)
		(uuid "08672b3b-d88e-5c2e-8569-638ad0b13c86")
	)
	(text "PWR_FLAG: #FLG01 marks the Eurorack GND entry; #FLG02/#FLG03 mark the rails, which are\nfed from the header only through the series diodes D1/D2 that ERC cannot see through."
		(exclude_from_sim no)
		(at 20.32 93.98 0)
		(effects
			(font
				(size 1.1 1.1)
			)
			(justify left)
		)
		(uuid "758902a2-298d-5d06-b92e-841e4bd2a7f1")
	)
	(text "CHANNELS (L top, R bottom): TS in -> 1k -> 1u -> T node -> 47k/56k (x0.544) -> OPA1678 follower = BUF\nBUF -> 100R -> LINE out.  BUF -> 50k pot (15k taper load) -> MC33178 follower -> 10R -> PHONES.\nLine level: 10 Vpp (+/-5 V Eurorack full scale) -> 1.92 Vrms, under the 2 Vrms consumer full scale."
		(exclude_from_sim no)
		(at 20.32 106.68 0)
		(effects
			(font
				(size 1.1 1.1)
			)
			(justify left)
		)
		(uuid "7ace293d-74ee-59e4-9ac5-03ff16111bed")
	)
	(text "OUTPUTS (TRS): line out T = L, R = R, S = GND; phones T = L, R = R, S = GND"
		(exclude_from_sim no)
		(at 243.84 106.68 0)
		(effects
			(font
				(size 1.4 1.4)
			)
			(justify left)
		)
		(uuid "85d391a2-67af-5276-a01d-e1e14887f242")
	)
	(text "POWER: Eurorack +/-12V -> B5819W series diodes -> +12V / -12V rails. +5 V not used."
		(exclude_from_sim no)
		(at 20.32 33.02 0)
		(effects
			(font
				(size 1.4 1.4)
			)
			(justify left)
		)
		(uuid "8995fb77-c1cc-5af0-9451-cecf6c78d5ec")
	)
	(text "NORMALLING: J2 (IN R) switch contact TN is wired to IN_L. With no plug in IN R,\nthe L input feeds the R channel too (mono L on both sides). A plug in IN R opens\nthe switch: stereo. No jumper."
		(exclude_from_sim no)
		(at 20.32 223.52 0)
		(effects
			(font
				(size 1.1 1.1)
			)
			(justify left)
		)
		(uuid "99ec11d9-6541-5d22-8a47-2ef680d61013")
	)
