	(text "NORMALS (U4 TS5A23157): jack empty -> TN = T pulls IN low -> COM = NC (MCO_OUT / VEL_CV);\npatched -> TN open, 1M pulls IN high -> COM = NO (AIN_BUF / CVIN_DIV)."
		(exclude_from_sim no)
		(at 251.46 205.74 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "0863acb9-1c12-5b0d-8e01-1a23176154fb")
	)
	(text "SUPPLY PINS + DECOUPLING"
