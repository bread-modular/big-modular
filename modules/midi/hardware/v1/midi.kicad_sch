	(text "JP1 TRS TYPE (2.54 mm header on the back): shunt 1-2 = TYPE A (Tip = data),\nshunt 2-3 = TYPE B (Ring = data). The unused conductor is left open.\nSleeve = GND (as Bread Modular V1). Firmware: no PORT_INVEN.\nOpto-isolated input (ground-loop break, voltage-sensed) is deferred to V2."
		(exclude_from_sim no)
		(at 20.32 152.4 0)
		(effects
			(font
				(size 1.1 1.1)
			)
			(justify left)
		)
		(uuid "3bc4d62b-a072-53f4-8cfa-6845f4012853")
	)
	(text "MIDI IN: Bread Modular V1 direct input (3.3 V and 5 V senders), no opto"
		(exclude_from_sim no)
