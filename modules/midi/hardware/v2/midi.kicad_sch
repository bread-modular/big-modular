	(text "UPDI J11: pin 1 UPDI, pin 2 GND (2.54 mm). Power the module from Eurorack while programming."
		(exclude_from_sim no)
		(at 175.26 177.8 0)
		(effects
			(font
				(size 1.1 1.1)
			)
			(justify left)
		)
		(uuid "06fed3aa-b3e6-5d85-825d-81c050cce8eb")
	)
	(text "OUTPUTS 1-8: sheets CH1-CH8 (out.kicad_sch): GPIO -> 1k -> TS tip (sleeve GND), BAT54SW\nclamp on the GPIO side; LED: GPIO -> 10k -> NPN, +5V -> LED -> 1k -> collector (Bread Modular gate_out)"
		(exclude_from_sim no)
		(at 256.54 25.4 0)
		(effects
			(font
				(size 1.4 1.4)
			)
			(justify left)
		)
		(uuid "183aeb5f-959c-5b10-8625-2b4814d6ec4f")
	)
	(text "JP1 TRS TYPE (2.54 mm header on the back): shunt 1-2 = TYPE A (Tip = data),\nshunt 2-3 = TYPE B (Ring = data). The unused conductor is left open.\nSleeve = GND (as Bread Modular V1). Q1 inverts: firmware sets PORT_INVEN on PB3.\nNo optocoupler in V2 (ground-loop isolation stays a later item)."
		(exclude_from_sim no)
		(at 20.32 152.4 0)
		(effects
			(font
				(size 1.1 1.1)
			)
			(justify left)
		)
		(uuid "3bc4d62b-a072-53f4-8cfa-6845f4012853")
	)
	(text "MIDI IN: NPN front end (3.3 V and 5 V senders, +/-12 V tolerant), no opto"
		(exclude_from_sim no)
		(at 20.32 101.6 0)
		(effects
			(font
				(size 1.4 1.4)
			)
			(justify left)
		)
		(uuid "3d571862-90bd-51d5-aa37-5fdf89b7206d")
	)
	(text "MCU: ATtiny1616 at 5 V, 20 MHz; pin map identical to Bread Modular"
		(exclude_from_sim no)
		(at 175.26 71.12 0)
		(effects
			(font
				(size 1.4 1.4)
			)
			(justify left)
		)
		(uuid "5665bf63-9b6e-565e-9eb3-a824673bbee0")
	)
	(text "PWR_FLAG: #FLG01 marks the Eurorack GND entry; #FLG02 marks VIN_LDO, which is\nfed from +12V only through passives (D10, R20) that ERC cannot see through."
		(exclude_from_sim no)
		(at 20.32 86.36 0)
		(effects
			(font
				(size 1.1 1.1)
			)
			(justify left)
		)
		(uuid "77b72957-efc4-5c4b-8ec7-79148453baf1")
	)
	(text "POWER: Eurorack +12V -> B5819W -> 39R -> HT7550-1 -> +5V.  -12V (J10 pins 1-2) unused."
		(exclude_from_sim no)
		(at 20.32 33.02 0)
		(effects
			(font
				(size 1.4 1.4)
			)
			(justify left)
		)
		(uuid "8b379a0b-4cc4-5ec5-ba3a-d33a42f0bda3")
	)
	(text "BIG MODULAR MIDI V2 - S3 schematic (5 V logic, mis-patch protected in/out). Circuit intent: docs/research.md 7"
		(exclude_from_sim no)
		(at 20.32 20.32 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left)
		)
		(uuid "8fdcd87b-b3a9-52f8-b9cf-b0a3172fea14")
	)
	(text "U2 +5V CLAMP: sinks output-clamp current above ~5.5 V (the LDO cannot sink)."
		(exclude_from_sim no)
		(at 142.24 33.02 0)
		(effects
			(font
				(size 1.1 1.1)
			)
			(justify left)
		)
		(uuid "9e530ae0-61f1-541e-9a96-8263b74360a6")
	)
	(text "JP2 RX SOURCE (solder jumper on the back, shipped OPEN: bridge one pair by hand):\nSolder 1-2 = PROTECTED (Q1 drives PB3; firmware PORT_INVEN on PB3).\nSolder 2-3 = DIRECT debug path (MIDI_IN to PB3 as V1, unprotected;\nPORT_INVEN off). Exactly one bridge: never both, and open = PB3 floats."
		(exclude_from_sim no)
		(at 20.32 170.18 0)
		(effects
			(font
				(size 1.1 1.1)
			)
			(justify left)
		)
		(uuid "dbf8f37e-fe95-59bd-b17a-3d3ce9777f20")
	)
