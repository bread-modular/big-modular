	(text "BIG MODULAR USB-AUDIO - MCU board, S1. CH32V307RCT6, USB 2.0 High-Speed (UAC2, 192 kHz / 24-bit, 2 in / 2 out). Circuit intent: docs/research.md"
		(exclude_from_sim no)
		(at 20.32 20.32 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left)
		)
		(uuid "13e509ca-9a16-5510-942a-9fab87b78249")
	)
	(text "CARRIER HEADERS: J102 = carrier J6, J103 = carrier J7 (2.54 mm pin strips,\nsoldered through both boards; the strips are in the carrier BOM)."
		(exclude_from_sim no)
		(at 200.66 83.82 0)
		(effects
			(font
				(size 1.1 1.1)
			)
			(justify left)
		)
		(uuid "3d2f4c15-0d0a-5f48-a0e6-17929cf78b3f")
	)
	(text "BOOT/RESET buttons and the SWD header are on the carrier (B side).\nHold BOOT, press RESET: ROM bootloader on the USB-C (wchisp / WCHISPTool)."
		(exclude_from_sim no)
		(at 86.36 83.82 0)
		(effects
			(font
				(size 1.1 1.1)
			)
			(justify left)
		)
		(uuid "6f48d669-de09-531f-b46e-2cbc7a2ebbf6")
	)
	(text "I2S2 slave RX: PB13 CK, PB12 WS, PB15 SD (codec SDOUT). I2S3 slave TX: PB3 CK, PA15 WS,\nPB5 SD (codec SDIN). I2C2: PB10/PB11. PB14 codec RST. The codec is the clock master."
		(exclude_from_sim no)
		(at 119.38 228.6 0)
		(effects
			(font
				(size 1.1 1.1)
			)
			(justify left)
		)
		(uuid "a2983f94-3d1e-5f26-b096-3ab4cd606fe0")
	)
	(text "USB-C (vertical, through the panel): data only, VBUS sensed on PA9 (no power drawn).\nD+/D- -> USBLC6-2SC6 -> PB7/PB6 = USBHS_DP/DM (also the ROM bootloader port)."
		(exclude_from_sim no)
		(at 20.32 129.54 0)
		(effects
			(font
				(size 1.1 1.1)
			)
			(justify left)
		)
		(uuid "d03af636-9b7b-5cf0-97f0-2008be577ee7")
	)
