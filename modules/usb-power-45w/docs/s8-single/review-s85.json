    "arming_calcs": {
      "required": [
        "R1 bounded: ARMED within the U11 delay (0.31-0.88 s) of the first converter enable after RESET, and held until RESET/FAULT: the converters can never run unarmed for longer",
        "R2 no restart: nothing a fault can toggle (MAIN_OK, PGOOD, VPD, V20_OK, the rails) restarts or extends the window; only RESET (or a power-on reset) does",
        "R3 no early arming: the window starts only at a genuine converter enable, i.e. U5 on through its own UVLO with valid status; the PD 5 V phase or an intermediate PDO cannot start it, so no threshold below the converter enable point can arm",
        "R4 fail-safe: after ARMED any bad status > ~1 ms latches FAULT; FAULT holds RUN low until RESET; OV_N (U20 guard) presets FAULT at any time"
      ],
      "topology": {
        "STARTED": "U12 flip-flop A used as a set/reset latch: PRE_N = START_N, CLR_N = RESET_N, CLK = GND (no clock edges), D = V3V3, Q = STARTED (TP19)",
        "START_N": "U14 gate 2 (spare in S8.4): NAND(MAIN_LED_OK, RUN, V3V3, V3V3); low once U5 is on with PGOOD and FLT good, its status validated by V20_OK, while RUN. Level-sensitive, so a MAIN_OK that is already high at RESET release (PGOOD deglitch) still starts it; RUN in the gate keeps PRE_N high while RESET clears the latch",
        "TIMER_GO": "U13 gate 3 = RUN AND STARTED -> R69/R70 -> U11 SENSE (unchanged divider)",
        "ARMED": "U11 RESET output (R71 pull-up) = ARMED directly; it stays high because its input is latched",
        "parts": "no new IC: the spare U14 gate and U12 flip-flop A re-used, R83 200k -> 120k (Basic, same line as R75), TP19 (copper); U23 and the rest of S8.4 unchanged"
      },
      "V20_OK": {
        "role": "U5 status-validity floor: masks U5 FLT/PGOOD (MAIN_OK, R63 pull-up) where U5 is below its 4.5 V operating minimum (PD 5 V phase); NOT an input-good threshold",
        "band_V": [
          9.062,
          9.977,
          10.961
        ],
        "R83": 120000.0,
        "rule": "band minimum >= vSafe5V max 5.5 V + 2.0 V and band maximum <= U5 turn-off minimum - 2.0 V",
        "rule_holds": true,
        "margin_above_vSafe5V_max_V": 3.562,
        "margin_below_U5_off_min_V": 4.077,
        "consequence": "whenever U5 can be on (VPD >= its 15.04 V turn-off minimum) V20_OK is high, so MAIN_LED_OK = MAIN_OK there and V20_OK can never be the first status to drop; ANY_BAD = NOT(MAIN_LED_OK AND P12_OK AND P5_OK AND N12_OK) means \"U5 not on with valid status, or a rail below its monitor threshold\"",
        "S8.4_200k_band_V": [
          14.621,
          16.116,
          17.727
        ],
        "S8.4_200k_rule_holds": false,
        "S8.3_220k_band_V": [
          16.011,
          17.651,
          19.419
        ],
        "S8.4_problem": "S8.4 V20_OK 14.62-17.73 V tripped below the U5 turn-on band (16.23-18.23 V) and above its turn-off minimum, so it meant neither \"input good\" nor \"status valid\"; S8.3 (220k, up to ~19.4 V) could mask arming indefinitely. With TIMER_GO = RUN AND MAIN_OK a fault cycling U5 (overload auto-retry, sagging source) restarted the window forever, and MAIN_OK floating high in the PD 5 V phase armed the board before 20 V arrived"
      },
