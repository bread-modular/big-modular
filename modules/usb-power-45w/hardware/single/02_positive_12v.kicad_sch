-b155-314f1a9dc4e5")) (hierarchical_label "MAIN_OK" (shape bidirectional) (at 114.30000000000001 246.38 180) (effects (font (size 1.1 1.1)) (justify right)) (uuid "8874bf36-1b80-540b-b1e2-2509b03aa642")) (label "MAIN_OK" (at 129.54000000000002 246.38 0) (effects (font (size 1.1 1.1)) (justify left bottom)) (uuid "c6bbbab9-b1fa-5b7a-a863-bde6896da5bf")) (hierarchical_label "VIN" (shape bidirectional) (at 203.20000000000002 246.38 180) (effects (font (size 1.1 1.1)) (justify right)) (uuid "80124f85-18a8-510f-8b0e-ec93babfab11")) (label "VIN" (at 218.44000000000003 246.38 0) (effects (font (size 1.1 1.1)) (justify left bottom)) (uuid "ed1a26f4-a04b-5495-8275-096a2c23f879")) (text "INTER-SHEET INTERFACE (see wired power-flow overview)" (at 20.32 225.88 0) (effects (font (size 1.2 1.2)) (justify left top)) (uuid "c9f68bda-2dca-5328-8558-d1314b9bfbce")) (text "S9.0: TPS552892-Q1 four-switch buck-boost: regulates 12.08 V from the whole converter input (10.55 V U5 sag ..\n16.5 V, and 21 V for the later 20 V retarget). The S8 TPS62933F buck needed 0.995-1.053 duty at the 12.5 V low line\n(1.033 even unloaded), above its 98 % maximum. 966 kHz (R110), L1 6.8 uH, FPWM, internal LDO (MODE/EXTVCC = VCC).\nR109 15 mR: constant-current limit 3.14-3.53 A = the +12V capability (published 2.4 A); large rack C charges at it.\nFB R8/R9 after R109; COMP R111/C83 (~10 kHz screen, bench Bode open). C11-C14, C79, C80 + C81 at VOUT;\nC34 (J2) and C59 (J3) at the headers on page 05. Its VOUT OVP (22.5-24.5 V) is not a 12 V protection (U20 is)." (at 20.32 190.5 0) (effects (font (size 1.15 1.15)) (justify left top)) (uuid "e689bdde-10ff-536d-a18c-4600453b77a7")) (wire (pts (xy 20.32 48.26) (xy 27.94 48.26)) (stroke (width 0) (type default)) (uuid "b13ce642-5e83-5976-901e-6ec52af6f28a")) (wire (pts (xy 25.4 246.38) (xy 40.64 246.38)) (stroke (width 0) (type default)) (uuid "b4847f71-fb73-5dff-816e-16c0cbb0fd58")) (wire (pts (xy 27.94 48.26) (xy 38.1 48.26)) (stroke (width 0) (type default)) (uu