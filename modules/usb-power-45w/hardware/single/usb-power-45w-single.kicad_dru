(version 1)
# User-authorised (2026-10-31) front-interface copper-edge allowances: the ONLY copper-edge exceptions.
# Every other item keeps the 1.0 mm board-setup copper-edge clearance (the two rear J1
# lugs, SW1 signal pads 1-3, the LEDs and all other copper included). Each window holds
# only the named pads at their current positions; moving the part takes them out of the
# window, so the 1.0 mm rule applies again.

# J1: "USB is fine. Make an exception for that." Two forward HRO TYPE-C-31-M-12 S1 shell
# lugs at X64.93 / X73.57, Y100.875 (measured 0.604 mm to the Y102.275 front edge).
(rule "J1_front_shell_lugs_edge_0p55"
	(constraint edge_clearance (min 0.55mm))
	(condition "A.Type == 'Pad' && A.Parent == 'J1' && A.Pad_Number == 'S1' && A.Position_Y > 100.6mm && A.Position_Y < 101.15mm && ((A.Position_X > 64.8mm && A.Position_X < 65.06mm) || (A.Position_X > 73.44mm && A.Position_X < 73.7mm))"))

# SW1 (RESET): "Yes. Allow it." Two TL3340 MP case pads at X102.60 / X106.90, Y101.325
# (1.9 x 0.7, measured 0.600 mm to the Y102.275 front edge).
(rule "SW1_MP_case_pads_edge_0p55"
	(constraint edge_clearance (min 0.55mm))
	(condition "A.Type == 'Pad' && A.Parent == 'SW1' && A.Pad_Number == 'MP' && A.Position_Y > 101.2mm && A.Position_Y < 101.45mm && ((A.Position_X > 102.47mm && A.Position_X < 102.73mm) || (A.Position_X > 106.77mm && A.Position_X < 107.03mm))"))

# ---- S9.2 / P2.2 routing contract: GENERATED by tools/place_s8.py --apply-rules from tools/s92_contract.py ----
# Do not edit by hand. Net classes live in usb-power-45w-single.kicad_pro, the RA_* rule areas on the board.
# Rules are evaluated last first; of two overlapping clearance rules the stricter comes later.
# docs/s8-single/routing-notes.md section 3.12 explains every rule.

# S9.2b: every via is the plain JLCPCB 0.3/0.6 mm through via (annular ring 0.15 mm); no other size, no microvia, no blind or buried via
(rule "S92_via_standard"
	(condition "A.Type == 'Via'")
	(constraint via_diameter (min 0.6mm) (opt 0.6mm) (max 0.6mm))
	(constraint hole_size (min 0.3mm) (opt 0.3mm) (max 0.3mm))
	(constraint annular_width (min 0.15mm))
	(constraint disallow micro_via blind_via buried_via))

# S9.2b: via drill >= 0.3 mm from copper of any other net (JLCPCB standard DFM, no special order)
(rule "S92_via_hole_to_copper"
	(condition "A.Type == 'Via'")
	(constraint hole_clearance (min 0.3mm)))

# In1 is the solid PGND plane: no track of any net (3.1)
(rule "S92_In1_solid_PGND"
	(layer "In1.Cu")
	(constraint disallow track))

# no logic-width track on a power net; the current-path minimums are POST_ROUTING min_widths
(rule "S92_power_width_floor"
	(condition "A.hasNetclass('VIN') || A.hasNetclass('PWR_12V') || A.hasNetclass('PWR_N12V') || A.hasNetclass('GND')")
	(constraint track_width (min 0.25mm)))

# control and logic tracks >= 0.25 mm
(rule "S92_QUIET"
	(condition "A.hasNetclass('QUIET')")
	(constraint track_width (min 0.25mm) (opt 0.25mm)))

# switch nodes: F.Cu pours, no vias, no thin tracks (3.4/3.5)
(rule "S92_SWITCH"
	(condition "A.hasNetclass('SWITCH')")
	(constraint track_width (min 0.5mm) (opt 1.0mm))
	(constraint disallow via))

# Kelvin pair: 0.2 mm, coupled gap 0.2-0.3 mm, no via, no pour (3.7)
(rule "S92_SENSE_pair"
	(condition "A.hasNetclass('SENSE')")
	(constraint track_width (min 0.2mm) (opt 0.2mm) (max 0.2mm))
	(constraint diff_pair_gap (min 0.2mm) (opt 0.2mm) (max 0.3mm))
	(constraint disallow via zone))

# the sense pair runs on F.Cu only
(rule "S92_SENSE_F_Cu_only"
	(condition "A.hasNetclass('SENSE') && A.Layer != 'F.Cu'")
	(constraint disallow track))

# AGND_U2: trace-only, at most one via pair, no pour on any layer (3.3)
(rule "S92_AGND_U2_island"
	(condition "A.hasNetclass('AGND_U2')")
	(constraint track_width (min 0.25mm) (opt 0.25mm))
	(constraint via_count (max 2))
	(constraint disallow zone))

# no AGND_U2 track on In1/In2
(rule "S92_AGND_U2_no_inner_copper"
	(layer inner)
	(condition "A.hasNetclass('AGND_U2')")
	(constraint disallow track))

# the single B.Cu AGND_U2 link is 0.25 mm
(rule "S92_AGND_U2_B_Cu_link"
	(layer "B.Cu")
	(condition "A.hasNetclass('AGND_U2')")
	(constraint track_width (min 0.25mm) (opt 0.25mm) (max 0.25mm)))

# AGND_U2 copper keeps 0.3 mm from every PGND item; the only bridge is the R113 body (pads 0.85 mm apart)
(rule "S92_AGND_U2_to_PGND"
	(condition "A.hasNetclass('AGND_U2') && B.hasNetclass('GND')")
	(constraint clearance (min 0.3mm)))

# sense pair >= 0.3 mm from P12_VOUT/+12V force copper; exempt: the R109/U2 land gaps and the U2 pin escape
(rule "S92_SENSE_to_force"
	(condition "A.hasNetclass('SENSE') && B.hasNetclass('PWR_12V') && !(A.Type == 'Pad' && B.Type == 'Pad' && A.Reference == B.Reference) && !A.enclosedByArea('RA_U2_SENSE_ESCAPE')")
	(constraint clearance (min 0.3mm)))

# quiet nets >= 0.5 mm from switch-node copper (3.4/3.5)
(rule "S92_QUIET_to_SWITCH"
	(condition "A.hasNetclass('QUIET') && B.hasNetclass('SWITCH')")
	(constraint clearance (min 0.5mm)))

# every D1/D24/D26 pad >= 0.4 mm from copper of any other net (the clamp voltage appears across these gaps)
(rule "S92_TVS_pad_stress"
	(condition "A.Type == 'Pad' && (A.Reference == 'D1' || A.Reference == 'D24' || A.Reference == 'D26')")
	(constraint clearance (min 0.4mm)))

# no foreign-net track or via inside the U2/L1 cell (3.4)
(rule "S92_U2_cell_own_nets"
	(condition "A.intersectsArea('RA_U2_CELL') && A.NetName != 'VIN' && A.NetName != 'GND' && A.NetName != '/+12 V buck-boost converter/P12_VOUT' && A.NetName != '+12V' && A.NetName != 'Net-(U2-SW1)' && A.NetName != 'Net-(U2-SW2)' && A.NetName != 'Net-(U2-BOOT1)' && A.NetName != 'Net-(U2-BOOT2)' && A.NetName != 'Net-(U2-EXTVCC)' && A.NetName != '/MAIN_OK' && A.NetName != 'Net-(U2-FSW)' && A.NetName != '/+12 V buck-boost converter/AGND_U2' && A.NetName != 'Net-(U2-FB)' && A.NetName != 'Net-(U2-COMP)' && A.NetName != 'Net-(C83-Pad1)' && A.NetName != '/+12 V buck-boost converter/P12_ISP' && A.NetName != '/+12 V buck-boost converter/P12_ISN'")
	(constraint disallow track via))

# on B.Cu inside the cell only the PGND pour and the AGND_U2 link (3.1)
(rule "S92_U2_cell_B_Cu"
	(layer "B.Cu")
	(condition "A.intersectsArea('RA_U2_CELL') && !A.hasNetclass('GND') && !A.hasNetclass('AGND_U2')")
	(constraint disallow track))

# only PGND vias inside the hot loops; C8/C81 connect on F.Cu (3.4)
(rule "S92_U2_hot_loop_vias"
	(condition "A.intersectsArea('RA_U2_HOT_LOOP') && !A.hasNetclass('GND')")
	(constraint disallow via))

# only the island's own nets inside RA_AGND_ISLAND
(rule "S92_AGND_island_nets"
	(condition "A.intersectsArea('RA_AGND_ISLAND') && A.NetName != '/+12 V buck-boost converter/AGND_U2' && A.NetName != 'GND' && A.NetName != 'Net-(U2-EXTVCC)' && A.NetName != 'Net-(U2-FB)' && A.NetName != 'Net-(U2-COMP)' && A.NetName != 'Net-(C83-Pad1)' && A.NetName != '/+12 V buck-boost converter/P12_ISP' && A.NetName != '/+12 V buck-boost converter/P12_ISN' && A.NetName != '+12V'")
	(constraint disallow track via))

# S9.2b: no via in or touching any pad, any net, SMD or THT (owner: no via-in-pad anywhere); no footprint carries a plated hole in a pad either (tools/check_s8_board.py)
(rule "S92_no_via_in_pad"
	(condition "A.Type == 'Via' && B.Type == 'Pad'")
	(constraint physical_clearance (min 0.1mm)))

# TVS pads join their pours solid, no thermal spokes
(rule "S92_TVS_pads_solid"
	(condition "A.Type == 'Pad' && (A.Reference == 'D1' || A.Reference == 'D24' || A.Reference == 'D26')")
	(constraint zone_connection solid))

# U2 VIN/SW/PGND/VOUT bars, C8, C81 and L1 join their pours solid
(rule "S92_hot_loop_pads_solid"
	(condition "A.Type == 'Pad' && ((A.Reference == 'U2' && (A.Pad_Number == '7' || A.Pad_Number == '8' || A.Pad_Number == '9' || A.Pad_Number == '10' || A.Pad_Number == '11')) || A.Reference == 'C8' || A.Reference == 'C81' || A.Reference == 'L1')")
	(constraint zone_connection solid))
