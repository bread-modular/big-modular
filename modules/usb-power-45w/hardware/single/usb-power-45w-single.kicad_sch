		(uuid "39a8c766-cf9b-5968-a24e-5d0646bebbe9")
	)
	(text "USB POWER S9.1 / SINGLE BOARD, +/-12V ONLY, 15 V PD INPUT"
		(exclude_from_sim no)
		(at 20.32 15.24 0)
		(effects
			(font
				(size 2.4 2.4)
			)
			(justify left top)
		)
		(uuid "74975e01-250f-5df9-b3d2-1bebdc83c886")
	)
	(text "ONE-SHOT FAULT POLICY\nSTARTED retains the first start within each power epoch.\nFaults cannot restart it; full power reset CAN. Repeated source resets FAIL qualification.\nOV_N presets FAULT asynchronously. Crowbar vs eFuse deferred/open."
		(exclude_from_sim no)
		(at 370.84 340.36 0)
		(effects
			(font
				(size 1.4 1.4)
			)
			(justify left top)
		)
		(uuid "7da72ec9-6fed-57a0-b2d5-fed520316984")
	)
	(text "15 V PD / TPS16630 / VIN clamp"
		(exclude_from_sim no)
		(at 50.8 152.4 0)
		(effects
			(font
				(size 1.4 1.4)
			)
			(justify left top)
		)
		(uuid "83b1cd89-6b65-5f48-90f3-7699af3b931c")
	)
	(text "+12V 2.4 A / -12V 0.8 A, <=33 W together (prototype, not measured).\n13.5-16.5 V at module; 15 V / 3 A PD. Rack +12V <=0.44 mF, impedance bounds in calcs.\nNo reverse-current blocking; no powered parallel supply or unrestricted hotplug qualification."
		(exclude_from_sim no)
		(at 370.84 386.08 0)
		(effects
			(font
				(size 1.2 1.2)
			)
			(justify left top)
		)
		(uuid "b31c55b0-ca50-5d5e-835f-1a11367089a2")
	)
	(text "Parallel +/-12V headers / monitors / MAIN LED"
