		(uuid "011a5c72-948b-58c9-98f2-d5a4f6b93067")
	)
	(text "CH224A: 20 V request\nTPS16630: 4.186 A common input switch\nVIN damper 1R + 2 x 10u"
		(exclude_from_sim no)
		(at 50.8 152.4 0)
		(effects
			(font
