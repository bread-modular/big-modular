	(text "USB POWER 45W S8.5 / SINGLE BOARD, +5V SERIES PROTECTION"
		(exclude_from_sim no)
		(at 20.32 15.24 0)
		(effects
			(font
				(size 2.4 2.4)
			)
			(justify left top)
		)
		(uuid "32c8b997-2e87-5965-841e-bb64890f51de")
	)
	(text "LMR38020F inverting buck-boost\n-12 V delivered rail"
		(exclude_from_sim no)
		(at 187.96 335.28 0)
		(effects
			(font
				(size 1.4 1.4)
			)
			(justify left top)
		)
		(uuid "3b6fc73e-225a-59c7-8d53-ccff83dc43e0")
	)
	(text "60 V always-on LDO / one-shot STARTED + FAULT latches\nManual RESET; OV_N presets FAULT"
		(exclude_from_sim no)
		(at 50.8 482.6 0)
		(effects
			(font
				(size 1.4 1.4)
			)
			(justify left top)
		)
		(uuid "547234b6-b892-5c0a-bbe1-d0eff89a0258")
	)
	(text "FAULT POLICY\nOne-shot qualification from the first converter enable (STARTED latch); after\n0.31-0.88 s any persistent bad status -> all OFF until RESET. Severe OV via U20 acts even before ARMED.\nU23 independently cuts +5V; OVLO alone is auto-recovering. U23 FLT is not latched.\nMAIN indicates enabled/status, not precision regulation."
		(exclude_from_sim no)
		(at 370.84 340.36 0)
		(effects
			(font
				(size 1.4 1.4)
			)
			(justify left top)
		)
		(uuid "6e5e6cb8-95b4-564e-ac0e-291647799a21")
	)
	(text "TPS62933F\n+12 V delivered rail"
		(exclude_from_sim no)
		(at 187.96 111.76 0)
		(effects
			(font
				(size 1.4 1.4)
			)
			(justify left top)
		)
		(uuid "7d3c67eb-94b1-5179-9d68-5c352f9fb86c")
	)
	(text "OUTPUTS: +12 / +5 / -12 on J2 and J3 in parallel\nPublished conservative rating (S8.4, prototype): 2.5 / 2.0 / 0.9 A,\n<=45 W total; above 2 A per rail use both headers. U23 ILIM 3.03 A nominal is a threshold, not a rating."
		(exclude_from_sim no)
		(at 370.84 386.08 0)
		(effects
			(font
				(size 1.2 1.2)
			)
			(justify left top)
		)
		(uuid "9b268910-9bc0-5d13-a15e-4fec20380940")
	)
	(text "TPS62933F\nP5_RAW before disconnect"
		(exclude_from_sim no)
		(at 187.96 223.52 0)
		(effects
			(font
				(size 1.4 1.4)
			)
			(justify left top)
		)
		(uuid "9b9e3961-cb38-5545-be1e-821d2ba98b3c")
	)
	(text "S8.5: +5V fast series disconnect (S8.4, FLT off the latch); +/-12V directly from converters; ceramic banks; two parallel outputs; VPD-powered OV guard; one-shot arming latch; MAIN LED only."
		(exclude_from_sim no)
		(at 20.32 25.4 0)
