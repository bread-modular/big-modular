	(paper "User" 560 530)
	(title_block
		(title "USB power S8 single board - wired power flow overview")
		(rev "S8.4")
		(company "Big Modular")
		(comment 1 "S8.4: single board, +5V series eFuse (FLT off the latch); +/-12V unswitched; MAIN only")
		(comment 2 "Arming from MAIN_OK; U18/U20 on VPD; split +5V banks; see docs/s8-single-board.md")
	)
	(lib_symbols)
	(text "Two Eurorack outputs J2 + J3\nMonitors, OV guard, +5V eFuse\nMAIN LED (only status LED)"
		(exclude_from_sim no)
		(at 381 294.64 0)
		(effects
			(font
				(size 1.4 1.4)
			)
			(justify left top)
		)
		(uuid "15c43331-c33a-5c98-b232-e60538a9b3b9")
	)
	(text "LMR38020F inverting buck-boost\n-12 V delivered rail"
		(exclude_from_sim no)
		(at 187.96 335.28 0)
		(effects
			(font
				(size 1.4 1.4)
			)
			(justify left top)
		)
		(uuid "32c8b997-2e87-5965-841e-bb64890f51de")
	)
	(text "FAULT POLICY\nQualification starts at MAIN_OK (converters enabled); persistent bad status after\n~0.57 s -> all OFF until RESET. Severe OV via U20 acts even before ARMED.\nU23 independently cuts +5V; OVLO alone is auto-recovering. U23 FLT is not latched.\nMAIN indicates enabled/status, not precision regulation."
		(exclude_from_sim no)
		(at 370.84 340.36 0)
		(effects
			(font
				(size 1.4 1.4)
			)
			(justify left top)
		)
		(uuid "39055b42-04be-5f7b-9f1d-12f7262d7c0a")
	)
	(text "OUTPUTS: +12 / +5 / -12 on J2 and J3 in parallel\nPublished conservative rating (S8.4, prototype): 2.5 / 2.0 / 0.9 A,\n<=45 W total; above 2 A per rail use both headers. U23 ILIM 3.03 A nominal is a threshold, not a rating."
		(exclude_from_sim no)
		(at 370.84 386.08 0)
		(effects
			(font
				(size 1.2 1.2)
			)
			(justify left top)
		)
		(uuid "4c5ea9e7-4759-5382-b89d-e947c36ed5a6")
	)
	(text "USB POWER 45W S8.4 / SINGLE BOARD, +5V SERIES PROTECTION"
		(exclude_from_sim no)
		(at 20.32 15.24 0)
		(effects
			(font
				(size 2.4 2.4)
			)
			(justify left top)
		)
		(uuid "7900f7e9-43c3-5529-a513-6dc0030b3192")
	)
	(text "TPS62933F\n+12 V delivered rail"
		(exclude_from_sim no)
		(at 187.96 111.76 0)
		(effects
			(font
				(size 1.4 1.4)
			)
			(justify left top)
		)
		(uuid "7fafe2a6-1948-5b78-9b98-4128ac35d1be")
	)
	(text "S8.4: +5V fast series disconnect (FLT off the latch); +/-12V directly from converters; ceramic banks; two parallel outputs; VPD-powered OV guard; arming from MAIN_OK; MAIN LED only."
		(exclude_from_sim no)
		(at 20.32 25.4 0)
		(effects
			(font
				(size 1.2 1.2)
			)
			(justify left top)
		)
		(uuid "92fa3644-95ef-59ce-af69-3d9101434dc9")
	)
	(text "TPS62933F\nP5_RAW before disconnect"
		(exclude_from_sim no)
		(at 187.96 223.52 0)
		(effects
			(font
				(size 1.4 1.4)
			)
			(justify left top)
		)
		(uuid "93210dac-ea2c-59c3-992d-4007e85e7fc3")
	)
	(text "CH224A: 20 V request\nTPS16630: 4.186 A common input switch\nVIN damper 1R + 2 x 10u"
		(exclude_from_sim no)
		(at 50.8 152.4 0)
		(effects
			(font
				(size 1.4 1.4)
			)
			(justify left top)
		)
		(uuid "f3a371e9-4f5d-52a0-9e70-65250097d686")
	)
	(text "60 V always-on LDO / retained ARMED + FAULT\nManual RESET; OV_N presets FAULT"
