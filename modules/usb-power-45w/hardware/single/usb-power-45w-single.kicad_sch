	(uuid "8dfe13f1-2242-548d-8407-aa702f14997e")
	(paper "User" 560 530)
	(title_block
		(title "USB power S8 single board - wired power flow overview")
		(rev "S8.2")
		(company "Big Modular")
		(comment 1 "S8.2: single board, no per-rail eFuses, ceramic bulk, two output headers, OV guard, MAIN LED only")
		(comment 2 "S8.1 review fixes (guard reference U21, LM2901B, 0.1 % dividers, clamp D22) + S8.2 +5V crowbar Q11 - docs/s8-single-board.md")
	)
	(lib_symbols)
	(text "Two Eurorack outputs J2 + J3\nMonitors, OV guard, +5V crowbar\nMAIN LED (only status LED)"
		(exclude_from_sim no)
		(at 381 294.64 0)
		(effects
			(font
				(size 1.4 1.4)
			)
			(justify left top)
		)
		(uuid "15c43331-c33a-5c98-b232-e60538a9b3b9")
	)
	(text "LMR38020F inverting buck-boost\n-12 V delivered rail"
		(exclude_from_sim no)
		(at 187.96 335.28 0)
		(effects
			(font
				(size 1.4 1.4)
			)
			(justify left top)
		)
		(uuid "32c8b997-2e87-5965-841e-bb64890f51de")
	)
	(text "FAULT POLICY\nEach rail is monitored after its converter.\nPersistent low rail (after ~0.57 s) or any overvoltage -> all OFF until RESET.\n+5V above ~5.8 V is also shorted by the SCR crowbar Q11.\nMain LED is not merely a +5 V lamp."
		(exclude_from_sim no)
		(at 370.84 340.36 0)
		(effects
			(font
				(size 1.4 1.4)
			)
			(justify left top)
		)
		(uuid "39055b42-04be-5f7b-9f1d-12f7262d7c0a")
	)
	(text "OUTPUTS: +12 / +5 / -12 on J2 and J3 in parallel\nNo per-rail current limit below the converter limits (TPS62933F 4.2-5.8 A peak; LMR38020F 2.6-3.8 A switch).\nTargets 2.5 / 2.5 / 1.0 A; not a guaranteed 54.5 W simultaneous rating."
		(exclude_from_sim no)
		(at 370.84 386.08 0)
		(effects
			(font
				(size 1.2 1.2)
			)
			(justify left top)
		)
		(uuid "4c5ea9e7-4759-5382-b89d-e947c36ed5a6")
	)
	(text "USB POWER 45W S8 / SINGLE BOARD, NO PER-RAIL EFUSES"
		(exclude_from_sim no)
		(at 20.32 15.24 0)
		(effects
			(font
				(size 2.4 2.4)
			)
			(justify left top)
		)
		(uuid "7900f7e9-43c3-5529-a513-6dc0030b3192")
	)
	(text "TPS62933F\n+12 V delivered rail"
		(exclude_from_sim no)
		(at 187.96 111.76 0)
		(effects
			(font
				(size 1.4 1.4)
			)
			(justify left top)
		)
		(uuid "7fafe2a6-1948-5b78-9b98-4128ac35d1be")
	)
	(text "S8.2: S7 converters kept; U6/U7 and the LM5067 negative switch removed; cans -> ceramics; two parallel 16-pin outputs; overvoltage guard (own TLV431B reference) on the fault latch; +5V SCR crowbar; MAIN LED only."
		(exclude_from_sim no)
		(at 20.32 25.4 0)
		(effects
			(font
				(size 1.2 1.2)
			)
			(justify left top)
		)
		(uuid "92fa3644-95ef-59ce-af69-3d9101434dc9")
	)
	(text "TPS62933F\n+5 V delivered rail"
		(exclude_from_sim no)
		(at 187.96 223.52 0)
		(effects
			(font
				(size 1.4 1.4)
			)
			(justify left top)
		)
		(uuid "93210dac-ea2c-59c3-992d-4007e85e7fc3")
	)
	(text "CH224A: 20 V request\nTPS16630: 4.186 A, the only switch\nVIN damper 1R + 2 x 10u"
		(exclude_from_sim no)
		(at 50.8 152.4 0)
		(effects
			(font
				(size 1.4 1.4)
			)
			(justify left top)
		)
		(uuid "f3a371e9-4f5d-52a0-9e70-65250097d686")
	)
	(text "60 V always-on LDO / retained ARMED + FAULT\nManual RESET; OV_N presets FAULT"
