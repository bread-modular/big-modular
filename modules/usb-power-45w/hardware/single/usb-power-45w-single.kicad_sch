		(uuid "74975e01-250f-5df9-b3d2-1bebdc83c886")
	)
	(text "ONE-SHOT FAULT POLICY\nSTARTED retains the first start within each power epoch.\nFaults cannot restart it; full power reset CAN. Repeated source resets FAIL qualification.\nOV_N presets FAULT asynchronously. Crowbar vs eFuse deferred/open."
		(exclude_from_sim no)
		(at 370.84 340.36 0)
		(effects
			(font
				(size 1.4 1.4)
			)
			(justify left top)
		)
		(uuid "7da72ec9-6fed-57a0-b2d5-fed520316984")
	)
	(text "15 V PD / TPS16630 / OVP + VIN clamp"
		(exclude_from_sim no)
		(at 50.8 152.4 0)
		(effects
			(font
				(size 1.4 1.4)
			)
			(justify left top)
		)
		(uuid "83b1cd89-6b65-5f48-90f3-7699af3b931c")
	)
	(text "+12V 2.4 A / -12V 0.8 A, <=33 W together (prototype, not measured; thermal rating conditional on the\nrouting contract). 13.5-16.5 V at module; 15 V / 3 A PD (start into the full rack needs ~4.65 A for ~2.5 ms:\nacceptance test S1). Rack <=0.44 mF. No reverse-current blocking; no powered parallel supply or hotplug."
		(exclude_from_sim no)
		(at 370.84 386.08 0)
		(effects
			(font
				(size 1.2 1.2)
			)
			(justify left top)
		)
		(uuid "b31c55b0-ca50-5d5e-835f-1a11367089a2")
	)
