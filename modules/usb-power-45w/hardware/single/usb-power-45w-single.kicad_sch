	(title_block
		(title "USB power S8 single board - wired power flow overview")
		(rev "S8.5")
		(company "Big Modular")
		(comment 1 "S8.5 single board: +5V eFuse as S8.4; +/-12V unswitched; MAIN LED only")
		(comment 2 "One-shot arming latch (STARTED); U18/U20 on VPD; see docs/s8-single-board.md")
	)
	(lib_symbols)
	(text "Two Eurorack outputs J2 + J3\nMonitors, OV guard, +5V eFuse\nMAIN LED (only status LED)"
