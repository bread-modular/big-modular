		(company "Big Modular")
		(comment 1 "S9.0 single board: +/-12V only (+5V subsystem removed); MAIN LED only")
		(comment 2 "One-shot arming latch (STARTED); U18/U20 on VPD; see docs/s8-single-board.md")
	)
	(lib_symbols)
	(text "Own-input enable; VIN pulse clamp; split U2 grounds; STARTED one-shot; no output crowbar."
		(exclude_from_sim no)
		(at 20.32 25.4 0)
