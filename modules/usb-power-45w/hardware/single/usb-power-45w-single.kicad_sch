	(text "USB POWER S9.2 / SINGLE BOARD, +/-12V ONLY, 15 V PD INPUT (ROUTING-READY, NOT ROUTED)"
		(exclude_from_sim no)
		(at 20.32 15.24 0)
		(effects
			(font
				(size 2.4 2.4)
			)
			(justify left top)
