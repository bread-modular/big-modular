	(text "USB-C PD 20 V INPUT: CH224A (CFG1 120k = 20 V), 5 A fuse, SMBJ20A TVS. VBUS sees only C1 + C2 (2 uF) at attach. Use a 20 V PD charger rated 45 W or more; 60 W for the full budget"
		(exclude_from_sim no)
		(at 25.4 26.67 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left)
		)
		(uuid "7886c374-d41b-5113-a4d4-bf06f023c364")
	)
	(text "Q1: -12V is enabled from +12V (starts at +12V ~ 8 V, stops when +12V goes): the -12V rail never runs alone. Internal compensation"
		(exclude_from_sim no)
		(at 22.86 111.76 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left)
		)
		(uuid "86b032b9-c839-5427-8c7a-f187cde7c6d4")
	)
	(text "+12V: U2 TPS62933F, forced PWM, 1.2 MHz, 6.8 uH. VOUT = 0.8 V x (1 + 47k / 3.3k) = 12.19 V"
