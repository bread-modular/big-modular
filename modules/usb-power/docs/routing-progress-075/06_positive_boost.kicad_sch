	(text "Layout handoff: minimize SW1/15/16-L5-D29-C77..80 loop; Kelvin FB to quiet PRAW/GND.\nSYNC5, RSVD10/14 and EP17 -> AGND; join AGND/PGND locally, ordinary0.300mm thermal vias.\nInput/ground/output branches shown are electrical connectivity, NOT PCB placement or routing.\nCCM compensation and DC+AC capacitance screens only; full-load start/stop/noise/thermal/loop tests pending."
		(exclude_from_sim no)
		(at 20.32 279.4 0)
		(effects
			(font
				(size 1.15 1.15)
			)
			(justify left top)
		)
		(uuid "7ebe4521-9152-5b68-b820-a5e2ee8a3904")
	)
	(text "06 / TPS55340 DIRECT VPROT BOOST - PRAW +13.519V"
		(exclude_from_sim no)
		(at 20.32 17.78 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left top)
		)
		(uuid "aed06d14-7a11-55ad-b06e-94d571e0add2")
	)
	(text "R86/R87=100k/10k, both0.1%25ppm/K precision exceptions. R88+R90=120k Basic (~400kHz).\nEN follows VPROT; SS100n ~30ms typical. L5/D29 precharge PRAW even with EN low.\nNo active sequencer, output disconnect or rail-synchronous shutdown claim."
		(exclude_from_sim no)
		(at 20.32 30.48 0)
		(effects
			(font
				(size 1.15 1.15)
			)
			(justify left top)
		)
		(uuid "c97dda4f-5922-52ff-ba20-16ba89eb28cd")
	)
