	(text "U5: P5 / 5.007547 V" (exclude_from_sim no) (at 22.86 162.56 0) (effects (font (size 1.35 1.35)) (justify left)) (uuid "44d3a300-d55b-5aca-9a75-319923f66e6e"))
	(text "BOOT C36 returns to SW, not GND. L4 is exact MDA1040-6R8M.\nRetained divider100k/(13k+510R), local C19/C38/C72.\nElectrical intent and U5 native component geometry retained; PCB remains unsynchronized." (exclude_from_sim no) (at 266.7 172.72 0) (effects (font (size 1 1)) (justify left)) (uuid "76b7528c-9461-58a9-bba9-542792b418fc"))
	(text "U5 remains direct VPROT -> P5, nominal5.007547V; 250mA shared-budget reserve.\nEN5 NC with internal pullup. U3 moved to sheet04, no MID converter or net remains." (exclude_from_sim no) (at 20.32 30.48 0) (effects (font (size 1.02 1.02)) (justify left)) (uuid "7e65869c-e391-54f5-8173-182b7232a847"))
