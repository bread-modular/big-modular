t top)) (uuid "43b13dfc-7c91-5266-bd13-536e5bc18aae")) (text "U12 ANY-OUT: 5,6,9,11 to GND; 4,8,10,12 float. SENSE3 -> final output.\nC60 sees approximately +12V. 4/6/4/3 x22u on IN+/OUT+/IN-/OUT-; typical bias + tolerance/temp/aging screen passes.\nRequire >=10u effective at each IN/OUT; >=20u at positive OUT for accuracy conditions." (at 20.32 137.16 0) (effects (font (size 1.1 1.1)) (justify left top)) (uuid "5e0b6744-3581-57aa-a86f-5fc59c9f8ddd")) (text "(R72+R83+R73)/R74 =92.3k/10k -> -12.02025V before IFB; 117.5uA nominal divider current (>5uA required).\nC61 100n: typical ~120ms start, not rail sequencing. C62 10n improves AC; shutdown FB kick remains a test gate.\nD27/D28 divert reverse current, do NOT block it. SS34 Vf does NOT prove the negative -0.3V differential limit.\n800mA aspiration is load-dependent, not a simultaneous rail guarantee. Capacitor bias/ESR, transient and board thermal qualification pending.\nAuthorized Basic1% divider substitutions; full-temperature negative dropout/accuracy is conditional, not a1A guarantee." (at 20.32 292.1 0) (effects (font (size 1.1 1.1)) (justify left top)) (uuid "3bdc25a0-87d3-577c-8027-691212c72538"))
	(symbol (lib_id "BigModular:Device_C") (at 60.96 91.44 0) (unit 1) (in_bom yes) (on_board yes) (dnp no) (uuid "ee53e6d7-8d11-5518-a425-ee474df4fc14") (instances (project "usb-power" (path "/d567704c-57ad-5df1-b183-cadb01fd8972/b4661736-5d66-5f3b-97a1-9dc3e47c41c6" (reference "C63") (unit 1)))) (property "Reference" "C63" (at 64.77000000000001 90.17 0) (effects (font (size 1.05 1.05)) (justify left))) (property "Value" "22u 25V X5R" (at 64.77000000000001 92.71 0) (effects (font (size 1.05 1.05)) (justify left))) (property "Footprint" "BigModular:C_1206_3216Metric" (at 60.96 91.44 0) (effects (font (size 1.05 1.05)) hide)) (property "Datasheet" "https://www.lcsc.com/datasheet/lcsc_datasheet_2304140030_Samsung-Electro-Mechanics-CL31A226KAHNNNE_C12891.pdf" (at 60.96 91.44 0) (effects (font (size 1.05 1.05)) hide)) (property "MPN" "CL31A226KAHNNNE" (at 60.96 91.44 0) (effects (font (size 1.05 1.05)) hide)) (property "LCSC" "C12891" (at 60.96 91.44 0) (effects (font (size 1.05 1.05)) hide)) (property "NOTE" "positive input bank: 4 parallel CL31A226KAHNNNE. Prototype screen at 14.8V raw/12.4V output includes -10% tolerance, -15% temperature, 5% aging allowance. >=10u effective required; positive output >=20u. Typical data is not a guaranteed minimum; lot/bias/temperature and stability bench acceptance required. X5R maximum85C; low-ESR ceramic, nonpolar. See docs/ldo-evidence/capacitor-disposition.json." (at 60.96 91.44 0) (effects (font (size 1.05 1.05)) hide)) (property "Manufacturer" "Samsung Electro-Mechanics" (at 60.96 91.44 0) (effects (font (size 1.05 1.05)) hide)) (pin "1" (uuid "8e28e745-cafb-5b6c-b124-93ed6ef57edc")) (pin "2" (uuid "5b98b02a-99b6-576e-a9d3-4409f30b2ea7")))
