	(text "J7: one manual harness; same +/-12V and independent P5.\nSR2 SCHEMATIC ONLY - PCB UNSYNCHRONIZED.\nOpus + DeepSeek reviews, corrections, user ACK; then PCB worker; no fabrication export." (exclude_from_sim no) (at 20.32 264.16 0) (effects (font (size 1.1 1.1)) (justify left)) (uuid "533aeb76-a1fd-5f56-a444-d49f27e9bf3b"))
	(text "9 V voltage acceptance is NOT proof of a PD protocol contract.\nNo MCU, AUX regulator, sensing/debug or artificial RUN inhibit.\nSW1 retries eFuse; UV/OV window remains independent." (exclude_from_sim no) (at 20.32 287.02 0) (effects (font (size 1.15 1.15)) (justify left)) (uuid "952c0b94-3759-524c-99d7-92a5f86fbc8d"))
